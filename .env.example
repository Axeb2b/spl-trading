# SPL Trading — environment variables
# Copy to .env.local and fill in real values. NEVER commit real secrets.

# Session signing secret. Generate with: openssl rand -hex 32
SPL_SESSION_SECRET=

# Absolute path to the SQLite database file (defaults to ./data/spl.sqlite)
# SPL_DB_PATH=

# Set to 1 ONLY in a controlled production environment after compliance sign-off.
# When unset or not "1", all money-movement feature flags are forced OFF regardless of DB config.
SPL_LIVE_MODE=0

# --- Binance Pay Merchant (Phase B, not yet wired) ---
# Provide these ONLY when an approved merchant account exists.
# BinanceMerchantId=
# BinanceApiKey=
# BinanceApiSecret=
# BinanceWebhookSecret=
