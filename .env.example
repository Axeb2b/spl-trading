# SPL Trading — environment variables
# Copy to .env.local and fill in real values.
# THIS FILE MUST CONTAIN PLACEHOLDERS ONLY — never real secrets, keys, or tokens.
# NEVER commit real secrets (.env*, .dev.vars* are gitignored).

# Session signing secret. Generate with: openssl rand -hex 32
SPL_SESSION_SECRET=

# Absolute path to the SQLite database file (defaults to ./data/spl.sqlite)
# SPL_DB_PATH=

# Directory holding the database file (used when SPL_DB_PATH is unset)
# SPL_DATA_DIR=

# Set to 1 ONLY in a controlled production environment after compliance sign-off.
# When unset or not "1", all money-movement feature flags are forced OFF regardless of DB config.
SPL_LIVE_MODE=0

# Fallback public BEP-20 receiving address shown to customers.
# The admin-configurable DB key bep20_deposit_address takes precedence when set.
SPL_BEP20_ADDRESS=

# Optional inputs for `npm run seed:admin` (otherwise pass CLI args or let it generate a password)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Cloudflare Workers + D1 (deployment target — NOT yet active; final verification pending) ---
# Provided to Cloudflare Workers Builds as CI secrets. Local dev does not need them.
# CLOUDFLARE_ACCOUNT_ID=
# D1 / wrangler database_id (set in wrangler.jsonc, not here)

# --- Telegram bot (§9, not yet implemented) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_IDS=

# --- Binance Pay Merchant (Phase B, not yet wired) ---
# Provide these ONLY when an approved merchant account exists.
# BinanceMerchantId=
# BinanceApiKey=
# BinanceApiSecret=
# BinanceWebhookSecret=
